{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "firestore.rules"
    ],
    "rewrites": [
      { "source": "/form",      "destination": "/form.html"      },
      { "source": "/dashboard", "destination": "/dashboard.html" }
    ]
  }
}
